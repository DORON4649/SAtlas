{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SAtlas",
  "version": "0.1.0",
  "identifier": "com.satlas.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SAtlas",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "satlas"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/DORON4649/SAtlas/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDMTVCNEZBRUUyQUJENTAKUldSUXZTcnUrclFWdkRxRERyQkU4akEwck1HOHJUQWxoSkJTald6ekpiM2UrS2M4a0R0WHcyNE4K"
    }
  }
}